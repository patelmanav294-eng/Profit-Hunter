// Trend Anchor — Trade-Ready Signal Tool
//
// Chart par BUY/SELL signal deta hai aur uske saath Entry, Stop Loss, TP1 aur TP2
// ki exact lines bhi draw karta hai — taaki signal aate hi pata ho kahan enter karna
// hai, kahan stop lagana hai, aur kahan book karna hai.
//
// Settings symbol ke hisab se apne aap select ho jaati hain (Gold / Silver / Oil).
// Backtest ke numbers ke liye README dekho — wo pichhle 2 saal ke H1 data par hain.
//
//@version=5
indicator("Trend Anchor Signals", shorttitle="Trend Anchor", overlay=true, max_labels_count=500)

// ============================================================
// INPUTS
// ============================================================
grpSetup = "Setup"
autoSettings = input.bool(true, "Symbol ke hisab se settings auto-select karo", group=grpSetup,
     tooltip="Gold/Silver/Oil detect karke unke tuned SL aur TP values lagata hai. Off karne par neeche wali manual values use hongi.")
mSlMult = input.float(2.0, "Manual: Stop Loss = ATR ×", minval=0.1, step=0.1, group=grpSetup)
mTp1RR = input.float(2.5, "Manual: TP1 R:R", minval=0.1, step=0.1, group=grpSetup)
mTp2RR = input.float(5.0, "Manual: TP2 R:R", minval=0.1, step=0.1, group=grpSetup)

grpDir = "Direction"
allowLongs = input.bool(true, "BUY signals dikhao", group=grpDir)
allowShorts = input.bool(false, "SELL signals dikhao", group=grpDir,
     tooltip="Backtest me shorts har timeframe par paisa khaate mile, isliye default OFF hai. Apne risk par on karo.")
confirmOnClose = input.bool(true, "Signal sirf candle band hone par confirm karo", group=grpDir,
     tooltip="ON rakho. Warna chalti hui candle me signal aata-jaata dikhega (repaint). Historical bars par koi farak nahi padta.")

grpTrend = "Trend (EMA)"
emaFastLen = input.int(9, "Fast EMA", minval=1, group=grpTrend)
emaSlowLen = input.int(21, "Slow EMA", minval=1, group=grpTrend)

grpMom = "Momentum (RSI + MACD)"
rsiLen = input.int(14, "RSI Length", minval=1, group=grpMom)
rsiBullMin = input.int(45, "RSI Bullish Min", group=grpMom)
rsiBullMax = input.int(75, "RSI Bullish Max", group=grpMom)
rsiBearMax = input.int(55, "RSI Bearish Max", group=grpMom)
rsiBearMin = input.int(25, "RSI Bearish Min", group=grpMom)
macdFast = input.int(12, "MACD Fast", group=grpMom)
macdSlow = input.int(26, "MACD Slow", group=grpMom)
macdSigLen = input.int(9, "MACD Signal", group=grpMom)

grpVol = "Volatility Filter (ATR)"
atrLen = input.int(14, "ATR Length", minval=1, group=grpVol)
atrAvgLen = input.int(50, "ATR Average Length", minval=1, group=grpVol)
minAtrRatio = input.float(0.8, "Min ATR / ATR-Average", minval=0.1, step=0.05, group=grpVol)

grpHtf = "Higher Timeframe Trend Filter"
useHtfFilter = input.bool(true, "HTF Trend Filter", group=grpHtf,
     tooltip="ISE OFF MAT KARO. Testing me ye is setup ka sabse bada edge nikla. OFF karne se signals kaafi zyada aate hain lekin quality khatam ho jaati hai.")
htfRes = input.timeframe("240", "Higher Timeframe", group=grpHtf)
htfEmaLen = input.int(50, "HTF EMA Length", group=grpHtf)

grpView = "Display"
showLevels = input.bool(true, "Entry / SL / TP lines dikhao", group=grpView)
showPanel = input.bool(true, "Info panel dikhao", group=grpView)
showEmas = input.bool(true, "EMA lines dikhao", group=grpView)

// ============================================================
// PER-SYMBOL SETTINGS
// ============================================================
tickerUp = str.upper(syminfo.ticker)
isGold = str.contains(tickerUp, "XAU") or str.contains(tickerUp, "GOLD")
isSilver = str.contains(tickerUp, "XAG") or str.contains(tickerUp, "SILVER")
isOil = str.contains(tickerUp, "UKOIL") or str.contains(tickerUp, "BRENT") or str.contains(tickerUp, "USOIL") or str.contains(tickerUp, "WTI")

// Backtest (last 2 years, H1) ke hisab se tuned values.
slMult = not autoSettings ? mSlMult : isGold ? 2.0 : isSilver ? 1.0 : isOil ? 1.0 : mSlMult
tp1RR = not autoSettings ? mTp1RR : isGold ? 2.5 : isSilver ? 2.0 : isOil ? 2.5 : mTp1RR
tp2RR = not autoSettings ? mTp2RR : isGold ? 5.0 : isSilver ? 3.0 : isOil ? 5.0 : mTp2RR
symbolName = isGold ? "GOLD" : isSilver ? "SILVER" : isOil ? "OIL" : "OTHER"

// ============================================================
// INDICATORS
// ============================================================
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
rsiVal = ta.rsi(close, rsiLen)
[macdLine, macdSig, macdHist] = ta.macd(close, macdFast, macdSlow, macdSigLen)
atrVal = ta.atr(atrLen)
atrAvg = ta.sma(atrVal, atrAvgLen)
htfEma = request.security(syminfo.tickerid, htfRes, ta.ema(close, htfEmaLen), lookahead=barmerge.lookahead_off)

volatilityOk = atrVal >= atrAvg * minAtrRatio
htfUp = close > htfEma
htfDn = close < htfEma

crossUp = ta.crossover(emaFast, emaSlow)
crossDown = ta.crossunder(emaFast, emaSlow)

buyRaw = crossUp and rsiVal >= rsiBullMin and rsiVal <= rsiBullMax and macdLine > macdSig and volatilityOk and (not useHtfFilter or htfUp)
sellRaw = crossDown and rsiVal <= rsiBearMax and rsiVal >= rsiBearMin and macdLine < macdSig and volatilityOk and (not useHtfFilter or htfDn)

// ============================================================
// TRADE STATE  (0 = flat, 1 = long, -1 = short)
// ============================================================
var int tradeDir = 0
var float entryPrice = na
var float stopPrice = na
var float tp1Price = na
var float tp2Price = na
var float initialStop = na
var bool tp1Done = false

flat = tradeDir == 0
barOk = not confirmOnClose or barstate.isconfirmed
newBuy = buyRaw and allowLongs and flat and barOk
newSell = sellRaw and allowShorts and flat and barOk

// --- manage an open position (checked before a new entry so one bar can close then re-open)
justHitTp1 = false
justClosed = false
closeReason = ""

if tradeDir != 0
    isLong = tradeDir == 1
    hitStop = isLong ? low <= stopPrice : high >= stopPrice
    hitTp1 = not tp1Done and (isLong ? high >= tp1Price : low <= tp1Price)
    hitTp2 = tp1Done and (isLong ? high >= tp2Price : low <= tp2Price)

    if hitStop
        justClosed := true
        closeReason := tp1Done ? "Breakeven par band (TP1 pehle hi book ho chuka)" : "Stop Loss hit"
        tradeDir := 0
        tp1Done := false
    else if hitTp1
        tp1Done := true
        justHitTp1 := true
        stopPrice := entryPrice          // cost to cost
    else if hitTp2
        justClosed := true
        closeReason := "TP2 hit — poora target complete"
        tradeDir := 0
        tp1Done := false

// --- open a new position
if (newBuy or newSell) and tradeDir == 0
    dir = newBuy ? 1 : -1
    risk = atrVal * slMult
    tradeDir := dir
    entryPrice := close
    initialStop := dir == 1 ? close - risk : close + risk
    stopPrice := initialStop
    tp1Price := dir == 1 ? close + risk * tp1RR : close - risk * tp1RR
    tp2Price := dir == 1 ? close + risk * tp2RR : close - risk * tp2RR
    tp1Done := false

inTrade = tradeDir != 0

// ============================================================
// PLOTTING
// ============================================================
plot(showEmas ? emaFast : na, "Fast EMA", color=color.new(color.orange, 30), linewidth=1)
plot(showEmas ? emaSlow : na, "Slow EMA", color=color.new(color.orange, 0), linewidth=2)

lvlEntry = showLevels and inTrade ? entryPrice : na
lvlStop = showLevels and inTrade ? stopPrice : na
lvlTp1 = showLevels and inTrade and not tp1Done ? tp1Price : na
lvlTp2 = showLevels and inTrade ? tp2Price : na

plot(lvlEntry, "Entry", color=color.new(color.gray, 0), linewidth=1, style=plot.style_linebr)
plot(lvlStop, "Stop Loss", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)
plot(lvlTp1, "TP1", color=color.new(color.aqua, 0), linewidth=1, style=plot.style_linebr)
plot(lvlTp2, "TP2", color=color.new(color.lime, 0), linewidth=2, style=plot.style_linebr)

plotshape(newBuy, title="BUY", style=shape.labelup, location=location.belowbar,
     color=color.new(color.lime, 0), textcolor=color.black, text="BUY", size=size.small)
plotshape(newSell, title="SELL", style=shape.labeldown, location=location.abovebar,
     color=color.new(color.red, 0), textcolor=color.white, text="SELL", size=size.small)
plotchar(justHitTp1, title="TP1 hit", char="●", location=location.abovebar,
     color=color.new(color.aqua, 0), size=size.tiny)

// ============================================================
// INFO PANEL
// ============================================================
f_px(p) => str.tostring(p, format.mintick)

var table panel = table.new(position.top_right, 2, 7, border_width=1, frame_width=1)

if showPanel and barstate.islast
    headBg = inTrade ? (tradeDir == 1 ? color.new(color.green, 25) : color.new(color.red, 25)) : color.new(color.gray, 40)
    headTxt = not inTrade ? "SIGNAL KA INTEZAAR" : tradeDir == 1 ? "BUY ACTIVE" : "SELL ACTIVE"

    table.cell(panel, 0, 0, symbolName + " · " + timeframe.period, text_color=color.white, bgcolor=headBg, text_size=size.small)
    table.cell(panel, 1, 0, headTxt, text_color=color.white, bgcolor=headBg, text_size=size.small)

    table.cell(panel, 0, 1, "Entry", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 1, inTrade ? f_px(entryPrice) : "—", text_color=color.white, text_size=size.small)

    table.cell(panel, 0, 2, tp1Done ? "Stop (breakeven)" : "Stop Loss", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 2, inTrade ? f_px(stopPrice) : "—",
         text_color=tp1Done ? color.aqua : color.red, text_size=size.small)

    table.cell(panel, 0, 3, "TP1 (50% book)", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 3, not inTrade ? "—" : tp1Done ? "✓ ho gaya" : f_px(tp1Price),
         text_color=color.aqua, text_size=size.small)

    table.cell(panel, 0, 4, "TP2 (baaki 50%)", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 4, inTrade ? f_px(tp2Price) : "—", text_color=color.lime, text_size=size.small)

    riskPts = inTrade ? math.abs(entryPrice - initialStop) : na
    table.cell(panel, 0, 5, "Risk (1R)", text_color=color.white, text_size=size.small)
    table.cell(panel, 1, 5, inTrade ? f_px(riskPts) : "—", text_color=color.white, text_size=size.small)

    nextStep = not inTrade ? "Setup banne ka wait karo" : tp1Done ? "Stop breakeven par hai — TP2 tak chalne do" : "TP1 par 50% book karna hai"
    table.cell(panel, 0, 6, "Ab kya", text_color=color.silver, text_size=size.tiny)
    table.cell(panel, 1, 6, nextStep, text_color=color.silver, text_size=size.tiny)

// ============================================================
// ALERTS
// ============================================================
// Rich alerts (levels ke saath). TradingView me "Any alert() function call" choose karo.
if newBuy
    alert("BUY " + syminfo.ticker + " (" + timeframe.period + ")" +
          "\nEntry: " + f_px(close) +
          "\nStop Loss: " + f_px(initialStop) +
          "\nTP1 (50% book): " + f_px(tp1Price) +
          "\nTP2: " + f_px(tp2Price) +
          "\nTP1 lagne par stop ko entry par le aana.", alert.freq_once_per_bar_close)

if newSell
    alert("SELL " + syminfo.ticker + " (" + timeframe.period + ")" +
          "\nEntry: " + f_px(close) +
          "\nStop Loss: " + f_px(initialStop) +
          "\nTP1 (50% book): " + f_px(tp1Price) +
          "\nTP2: " + f_px(tp2Price) +
          "\nTP1 lagne par stop ko entry par le aana.", alert.freq_once_per_bar_close)

if justHitTp1
    alert("TP1 HIT — " + syminfo.ticker +
          "\n50% position book karo aur stop ko entry (" + f_px(entryPrice) + ") par move karo." +
          "\nBaaki 50% ka target TP2: " + f_px(tp2Price), alert.freq_once_per_bar_close)

if justClosed
    alert("TRADE CLOSED — " + syminfo.ticker + "\n" + closeReason, alert.freq_once_per_bar_close)

// Simple alerts (dropdown se select karne ke liye, levels ke bina)
alertcondition(newBuy, title="Trend Anchor BUY", message="BUY signal — {{ticker}} {{interval}}")
alertcondition(newSell, title="Trend Anchor SELL", message="SELL signal — {{ticker}} {{interval}}")
alertcondition(justHitTp1, title="Trend Anchor TP1 hit (stop ko breakeven par le jao)",
     message="TP1 hit — {{ticker}}: 50% book karo, stop breakeven par le jao")
