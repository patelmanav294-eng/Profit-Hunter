// Profit Hunter — Gold / Silver / UKOil STRATEGY (backtestable)
// Same signal logic as the indicator, wired to TradingView's Strategy Tester
// so you get real historical Win Rate, R:R, Profit Factor, Max Drawdown per symbol.
// Apply separately to XAUUSD, XAGUSD, and UKOIL (or WTI/USOIL) charts, then open the
// "Strategy Tester" tab at the bottom of TradingView to read the results.
//@version=5
strategy("Profit Hunter - Gold/Silver/Oil Strategy", shorttitle="PH Strategy", overlay=true,
     initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=1,
     commission_type=strategy.commission.percent, commission_value=input.float(0.02, "Commission %"),
     slippage=input.int(2, "Slippage (ticks)"), pyramiding=0, process_orders_on_close=true)

// ============ INPUTS ============
grpTrend = "Trend (EMA)"
emaFastLen = input.int(9, "Fast EMA Length", minval=1, group=grpTrend)
emaSlowLen = input.int(21, "Slow EMA Length", minval=1, group=grpTrend)

grpMomentum = "Momentum (RSI + MACD)"
rsiLen = input.int(14, "RSI Length", minval=1, group=grpMomentum)
rsiBullMin = input.int(45, "RSI Bullish Min", group=grpMomentum)
rsiBullMax = input.int(75, "RSI Bullish Max (Overbought Cutoff)", group=grpMomentum)
rsiBearMax = input.int(55, "RSI Bearish Max", group=grpMomentum)
rsiBearMin = input.int(25, "RSI Bearish Min (Oversold Cutoff)", group=grpMomentum)
macdFast = input.int(12, "MACD Fast", group=grpMomentum)
macdSlow = input.int(26, "MACD Slow", group=grpMomentum)
macdSignalLen = input.int(9, "MACD Signal", group=grpMomentum)

grpVol = "Volatility Filter (ATR)"
atrLen = input.int(14, "ATR Length", minval=1, group=grpVol)
atrAvgLen = input.int(50, "ATR Average Length", minval=1, group=grpVol)
minAtrRatio = input.float(0.8, "Min ATR / ATR-Average Ratio", minval=0.1, step=0.05, group=grpVol)

grpTrendFilter = "Higher Timeframe Trend Filter"
useHtfFilter = input.bool(true, "HTF Trend Filter On/Off", group=grpTrendFilter)
htfRes = input.timeframe("240", "Higher Timeframe", group=grpTrendFilter)
htfEmaLen = input.int(50, "HTF EMA Length", group=grpTrendFilter)

grpRisk = "Risk Management (this is what sets your R:R)"
slAtrMultiplier = input.float(1.5, "Stop Loss = ATR x", minval=0.1, step=0.1, group=grpRisk)
riskReward = input.float(3.0, "Risk:Reward Ratio (TP = SL x this)", minval=0.5, step=0.1, group=grpRisk,
     tooltip="3.0 = for every 1 unit risked, target is 3 units reward (1:3 R:R). Backtest par isi R:R pe winrate kam (~30%) hone ke bawajood expectancy sabse best mili — trend-following systems me low winrate normal hai, expectancy dekho.")
allowLongs = input.bool(true, "Allow Long Trades", group=grpRisk)
allowShorts = input.bool(true, "Allow Short Trades", group=grpRisk)

grpBacktest = "Backtest Window"
startDate = input.time(timestamp("2023-01-01T00:00:00"), "Backtest Start Date", group=grpBacktest)

grpDisplay = "Display"
showEmas = input.bool(true, "Show EMA Lines", group=grpDisplay)

// ============ CALCULATIONS ============
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)

rsiVal = ta.rsi(close, rsiLen)

[macdLine, macdSignal, macdHist] = ta.macd(close, macdFast, macdSlow, macdSignalLen)

atrVal = ta.atr(atrLen)
atrAvg = ta.sma(atrVal, atrAvgLen)
volatilityOk = atrVal >= atrAvg * minAtrRatio

htfEmaVal = request.security(syminfo.tickerid, htfRes, ta.ema(close, htfEmaLen), lookahead=barmerge.lookahead_off)
htfTrendUp = close > htfEmaVal
htfTrendDown = close < htfEmaVal

// ============ CONDITIONS ============
rsiBull = rsiVal >= rsiBullMin and rsiVal <= rsiBullMax
rsiBear = rsiVal <= rsiBearMax and rsiVal >= rsiBearMin

macdBull = macdLine > macdSignal
macdBear = macdLine < macdSignal

htfBullOk = not useHtfFilter or htfTrendUp
htfBearOk = not useHtfFilter or htfTrendDown

crossUp = ta.crossover(emaFast, emaSlow)
crossDown = ta.crossunder(emaFast, emaSlow)

inWindow = time >= startDate

buySignal = crossUp and rsiBull and macdBull and volatilityOk and htfBullOk and inWindow
sellSignal = crossDown and rsiBear and macdBear and volatilityOk and htfBearOk and inWindow

// ============ ENTRIES (fixed SL/TP relative to actual fill price => exact R:R) ============
var float entryAtr = na

if buySignal and allowLongs and strategy.position_size <= 0
    entryAtr := atrVal
    strategy.entry("Long", strategy.long)

if sellSignal and allowShorts and strategy.position_size >= 0
    entryAtr := atrVal
    strategy.entry("Short", strategy.short)

slTicks = (entryAtr * slAtrMultiplier) / syminfo.mintick
tpTicks = slTicks * riskReward

if strategy.position_size > 0
    strategy.exit("Long Exit", from_entry="Long", loss=slTicks, profit=tpTicks)

if strategy.position_size < 0
    strategy.exit("Short Exit", from_entry="Short", loss=slTicks, profit=tpTicks)

// ============ PLOTTING ============
plot(showEmas ? emaFast : na, "Fast EMA", color=color.new(color.yellow, 0), linewidth=1)
plot(showEmas ? emaSlow : na, "Slow EMA", color=color.new(color.orange, 0), linewidth=2)

plotshape(buySignal, title="Buy Signal", style=shape.triangleup, location=location.belowbar, color=color.new(color.lime, 0), size=size.small, text="BUY")
plotshape(sellSignal, title="Sell Signal", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.small, text="SELL")
